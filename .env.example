# Server
NODE_ENV=development
PORT=3000
TRUST_PROXY=false

# Admin login
SESSION_SECRET=replace-with-a-long-random-secret

# Google OAuth for admin access
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/admin/oauth/google/callback
# Bootstrap only: these emails are inserted as owners when team_members is empty.
# Manage daily admin access from the dashboard after first login.
ADMIN_ALLOWED_EMAILS=you@example.com,teammate@example.com

# Supabase/Postgres
# Get this from Supabase Connect > Direct > Session pooler > Type: URI.
# Use the database password you set/reset in Supabase. Never expose this in frontend code.
DATABASE_URL=postgresql://postgres.tbkrcihxjjorwlpwbdxw:PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres
DB_SSL=true

# Comma-separated origins that may call /exp/resolve.
ALLOWED_ORIGINS=https://example.com,https://www.example.com
